# Database Configuration for Vercel Production Deployment
# Use ANY hosted MySQL provider (e.g. Railway MySQL, Aiven, PlanetScale, Neon MySQL, or AWS RDS)

# Option A: Full Connection URI (Recommended)
MYSQL_URL="mysql://username:password@host:port/database"
# Or
DATABASE_URL="mysql://username:password@host:port/database"

# Option B: Individual Connection Parameters
MYSQL_HOST="your-mysql-host.com"
MYSQL_PORT="3306"
MYSQL_USER="your-db-user"
MYSQL_PASSWORD="your-db-password"
MYSQL_DATABASE="railway"

# Enable SSL for cloud-hosted databases (default: true if using MYSQL_URL, or set explicitly)
MYSQL_SSL="true"

# Note: In Vercel, NEXT_PUBLIC_API_URL is NOT required because the frontend now calls
# the same-origin Next.js API routes (/api/...) directly.
